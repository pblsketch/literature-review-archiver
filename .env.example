# Notion API Key (Internal Integration Token)
# Create one here: https://www.notion.so/my-integrations
NOTION_KEY=secret_your_notion_key_here

# Google Gemini API Key
# Create one here: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Notion Database ID
# Open your database as full page -> Copy ID from URL: https://www.notion.so/{workspace_name}/{database_id}?v=...
NOTION_DATABASE_ID=your_database_id_here

# Google Cloud Service Account Key Path
# Required for Google Drive API. Download your JSON key from Google Cloud Console.
GOOGLE_APPLICATION_CREDENTIALS=./service_account_key.json
